# Local development only. Never place a provider key in a public build.
# Get your key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Supabase Project Configuration Keys (Sign up at https://supabase.com)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: authenticated server-side AI proxy (supabase/functions/gemini-proxy).
# When set, signed-in users' AI calls go through the proxy and the provider key
# stays on the server; guests keep using their own connected key.
VITE_GEMINI_PROXY_URL=
